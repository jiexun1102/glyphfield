{
  "name": "glyphfield",
  "version": "0.1.0",
  "description": "An interactive glyph-matrix backdrop that decodes words where the cursor rests, and keeps out of the way of your content.",
  "keywords": ["background", "backdrop", "canvas", "glyph", "matrix", "decode", "scramble", "react", "hero", "animation"],
  "license": "MIT",
  "author": "Teoh Jiexun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiexun1102/glyphfield.git"
  },
  "homepage": "https://github.com/jiexun1102/glyphfield#readme",
  "bugs": {
    "url": "https://github.com/jiexun1102/glyphfield/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "dev": "vite --config vite.playground.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:playground": "vite build --config vite.playground.config.ts",
    "prepublishOnly": "npm run lint && npm run build",
    "lint": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
